# --- Kết nối backend NestJS (không có /api ở cuối) ---
# Để TRỐNG các biến dưới đây thì app tự dò:
#   - Web mở bằng localhost / IP (vd https://192.168.2.131:5173) -> gọi API ở cùng host, cổng 3000, cùng http/https với trang
#   - App điện thoại -> IP máy đang chạy Metro, cổng 3000
# Chỉ đặt khi muốn ghi đè:
# EXPO_PUBLIC_API_URL=http://192.168.2.131:3000
# EXPO_PUBLIC_API_PORT=3000
# EXPO_PUBLIC_API_PROTOCOL=http

# URL web công khai dùng để sinh nội dung mã QR (https://greenfarmer.vn).
# Bỏ trống: web dùng domain hiện tại, app dùng deep link greenfarmer://
EXPO_PUBLIC_PUBLIC_URL=
