# URL gốc của backend NestJS (không có /api ở cuối).
# Bỏ trống: web -> http://localhost:3000, app trên điện thoại -> http://<IP máy đang chạy Metro>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# URL web công khai dùng để sinh nội dung mã QR (https://greenfarmer.vn).
# Bỏ trống: web dùng domain hiện tại, app dùng deep link greenfarmer://
EXPO_PUBLIC_PUBLIC_URL=
